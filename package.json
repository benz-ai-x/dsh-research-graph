{
  "name": "@benz-ai-x/dsh-research-graph",
  "description": "DeepSeek Harness plugin for organizing AI discussions into research topics, traceable knowledge cards, and reusable research materials on an interactive graph",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "cordis",
    "research-graph",
    "research-workflow",
    "knowledge-management",
    "session-visualization",
    "session-management",
    "ai-agent",
    "ai-agents",
    "agent-workflow",
    "subagent",
    "branching",
    "merge",
    "typescript",
    "react"
  ],
  "version": "0.1.5-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-research-graph-migrate": "lib/migrate-merge-history.js",
    "dsh-session-graph-migrate": "lib/migrate-merge-history.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "lib/migrate-merge-history.js",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "lib/client.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benz-ai-x/dsh-research-graph.git"
  },
  "bugs": {
    "url": "https://github.com/benz-ai-x/dsh-research-graph/issues"
  },
  "homepage": "https://github.com/benz-ai-x/dsh-research-graph#readme",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "node scripts/check-version.mjs && tsc --noEmit",
    "typecheck:harness": "node scripts/check-harness-types.mjs",
    "check:harness": "pnpm run typecheck:harness && pnpm run test:harness",
    "smoke:harness": "node scripts/smoke-profile.mjs",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "check": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "clsx": "^2.1.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "0.1.5-rc.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
